{
  "id": "machinemodule",
  "name": "Machinemodule",
  "abbrev": "MD",
  "version": "0.1.3",
  "min_host_version": "1.7.3",
  "description": "The Elektron Machinedrum SPS-1 UW's sound engine, emulated: 16 tracks on the 16 pads, the editor follows the pad you hit.",
  "author": "sd88me",
  "license": "AGPL-3.0",
  "dsp": "dsp.so",
  "api_version": 2,
  "assets": [
    {
      "path": "os",
      "label": "Machinedrum OS",
      "extensions": [
        ".syx"
      ],
      "description": "Requires the Machinedrum SPS-1 UW OS 1.63 file (.syx), a free download from Elektron's Machinedrum support page.",
      "hint": "Download the Machinedrum UW OS 1.63 from elektron.se, unzip it and upload the .syx file.",
      "files": [
        {
          "filename": "Elektron_SPS1-1UW_OS1.63.syx",
          "label": "Machinedrum UW OS 1.63",
          "required": true
        }
      ]
    },
    {
      "path": "flash",
      "label": "Machinedrum flash image",
      "extensions": [
        ".bin"
      ],
      "optional": true,
      "description": "Optional: the Machinedrum UW 1.63 flash image (.bin, 8 MB). Machinemodule boots it once in the emulated Machinedrum (about 6 minutes, the first time the module starts after the upload) and keeps the 16 factory kits and the ROM machines' samples. Nothing from it is shipped."
    },
    {
      "path": "kits",
      "label": "Your kits",
      "extensions": [
        ".syx"
      ],
      "optional": true,
      "description": "Optional: Machinedrum kit dumps (.syx, one or many kits per file, as the MD sends them). They are listed on the Kit page after the factory kits."
    }
  ],
  "capabilities": {
    "audio_out": true,
    "audio_in": false,
    "midi_in": true,
    "midi_out": false,
    "chainable": true,
    "component_type": "sound_generator",
    "forks_processes": true,
    "claims_edit_ccs": true
  },
  "ui_hierarchy": {
    "levels": {
      "root": {
